# ============================================
# Tripzy — Development Environment
# ============================================
# Copy this to .env.local with real values for local development.
# These are defaults; override in .env.local.
# ============================================

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripzy_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tripzy_dev"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- Google Maps ---
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# --- Cashfree ---
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="sandbox"

# --- Resend ---
RESEND_API_KEY="re_your_resend_api_key"

# --- MSG91 ---
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_SENDER_ID="TRIPZY"
MSG91_ROUTE="4"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
