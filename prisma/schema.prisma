  code            String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  country         Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities          City[]
  addresses       Address[]
}

model City {
  id              String      @id @default(uuid()) @db.Uuid
  stateId         String      @db.Uuid
  name            String
  code            String
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  state           State       @relation(fields: [stateId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]
  pickupLocations PickupLocation[]
  dropLocations   DropLocation[]
  addresses       Address[]

  // Advanced Relations
  surgePricingLogs SurgePricingLog[]

  @@index([stateId])
}

model PickupLocation {
  id              String      @id @default(uuid()) @db.Uuid
  cityId          String      @db.Uuid
  name            String
  address         String
  latitude        Float
  longitude       Float
  isAirport       Boolean     @default(false)
  isRailwayStation Boolean    @default(false)
  deliveryCharge  Decimal     @default(0.0) @db.Decimal(10, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  city            City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  bookings        Booking[]
}

model DropLocation {
  id              String      @id @default(uuid()) @db.Uuid
  cityId          String      @db.Uuid
  name            String
  address         String
  latitude        Float
  longitude       Float
  isAirport       Boolean     @default(false)
  isRailwayStation Boolean    @default(false)
  deliveryCharge  Decimal     @default(0.0) @db.Decimal(10, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  city            City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  bookings        Booking[]
}

// ==========================================
// BOOKING SYSTEM MODULE
// ==========================================

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  bookingNumber   String        @unique
  userId          String        @db.Uuid
  vehicleId       String        @db.Uuid
  pickupLocationId String       @db.Uuid
  dropLocationId  String        @db.Uuid
  fuelPolicyId    String?       @db.Uuid
  pickupDate      DateTime
  returnDate      DateTime
  status          BookingStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  securityDeposit Decimal       @db.Decimal(10, 2)
  couponId        String?       @db.Uuid
  discountAmount  Decimal       @default(0.0) @db.Decimal(10, 2)
  taxAmount       Decimal       @db.Decimal(10, 2)
  finalAmount     Decimal       @db.Decimal(10, 2)
  actualReturnDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid

  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  pickupLocation  PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  dropLocation    DropLocation   @relation(fields: [dropLocationId], references: [id], onDelete: Restrict)
  fuelPolicy      FuelPolicy?    @relation(fields: [fuelPolicyId], references: [id], onDelete: SetNull)
  coupon          Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)

  timelines       BookingTimeline[]
  extensions      BookingExtension[]
  cancellations   BookingCancellation[]
  payments        Payment[]
  invoices        Invoice[]
  couponUsages    CouponUsage[]
  walletTransactions WalletTransaction[]
  damageReports   VehicleDamageReport[]
  reviews         Review[]
  calendarBlocks  VehicleAvailabilityCalendar[]

  // Advanced Relations
  odometerHistory       OdometerHistory[]
  fuelLevelHistory      FuelLevelHistory[]
  inspections           VehicleInspectionChecklist[]
  loyaltyPointLogs      LoyaltyPointLog[]
  driverScoreLogs       DriverScoreLog[]

  @@index([status])
  @@index([pickupDate])
  @@index([returnDate])
  @@index([userId])
}

model BookingTimeline {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  statusChangedTo BookingStatus
  remarks         String?
  actionBy        String        @db.Uuid
  timestamp       DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingExtension {
  id                 String          @id @default(uuid()) @db.Uuid
  bookingId          String          @db.Uuid
  extendedReturnDate DateTime
  extraAmount        Decimal         @db.Decimal(10, 2)
  isPaid             Boolean         @default(false)
  transactionId      String?
  status             ExtensionStatus @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  createdBy          String?         @db.Uuid
  updatedBy          String?         @db.Uuid

  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingCancellation {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @db.Uuid
  reason          String
  cancelledBy     String       @db.Uuid
  refundAmount    Decimal      @default(0.0) @db.Decimal(10, 2)
  refundStatus    RefundStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdBy       String?      @db.Uuid
  updatedBy       String?      @db.Uuid

  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ==========================================
// PAYMENT MODULE
// ==========================================

model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  bookingId       String         @db.Uuid
  totalAmount     Decimal        @db.Decimal(10, 2)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentGateway  PaymentGateway
  gatewayPaymentId String?
  gatewayOrderId  String?
  invoiceId       String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  transactions    PaymentTransaction[]
  refunds         Refund[]
  walletTransactions WalletTransaction[]

  @@index([paymentStatus])
}

model PaymentTransaction {
  id              String            @id @default(uuid()) @db.Uuid
  paymentId       String            @db.Uuid
  amount          Decimal           @db.Decimal(10, 2)
  transactionType TransactionType
  status          TransactionStatus @default(PENDING)
  gatewayReference String?
  responseMessage String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdBy       String?           @db.Uuid
  updatedBy       String?           @db.Uuid

  payment         Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @db.Uuid
  amount          Decimal      @db.Decimal(10, 2)
  reason          String
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdBy       String?      @db.Uuid
  updatedBy       String?      @db.Uuid

  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique
  bookingId       String        @db.Uuid
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0.0) @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  issuedAt        DateTime      @default(now())
  pdfUrl          String?
  status          InvoiceStatus @default(UNPAID)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payments        Payment[]
}

model Coupon {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  type              CouponType
  value             Decimal      @db.Decimal(10, 2)
  minBookingValue   Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime
  usageLimitPerUser Int          @default(1)
  usageLimitGlobal  Int?
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  createdBy         String?      @db.Uuid
  updatedBy         String?      @db.Uuid

  bookings          Booking[]
  usages            CouponUsage[]

  // Advanced Relations
  promoCampaignId   String?      @db.Uuid
  promoCampaign     PromoCampaign? @relation(fields: [promoCampaignId], references: [id], onDelete: SetNull)
}

model CouponUsage {
  id              String      @id @default(uuid()) @db.Uuid
  couponId        String      @db.Uuid
  bookingId       String      @db.Uuid
  userId          String      @db.Uuid
  discountApplied Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  coupon          Coupon      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  booking         Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, couponId])
}

model Wallet {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @unique @db.Uuid
  balance         Decimal     @default(0.0) @db.Decimal(10, 2)
  currency        String      @default("INR")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletId        String                @db.Uuid
  type            WalletTransactionType
  amount          Decimal               @db.Decimal(10, 2)
  description     String
  bookingId       String?               @db.Uuid
  paymentId       String?               @db.Uuid
  status          TransactionStatus     @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  createdBy       String?               @db.Uuid
  updatedBy       String?               @db.Uuid

  wallet          Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking         Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment         Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

