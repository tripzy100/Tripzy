// ==========================================
// SECURITY & AUDIT MODULE
// ==========================================

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid

  userRoles       UserRole[]
  permissions     RolePermission[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId          String      @db.Uuid
  permissionId    String      @db.Uuid

  role            Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId          String      @db.Uuid
  roleId          String      @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  sessionToken    String      @unique
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  token           String      @unique
  expiresAt       DateTime
  deviceId        String?     @db.Uuid
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  deviceType      String
  deviceName      String
  pushToken       String?
  lastActiveAt    DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustedDevice {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @db.Uuid
  deviceFingerprint  String      @unique
  friendlyName       String
  trustExpiresAt     DateTime
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?
  createdBy          String?     @db.Uuid
  updatedBy          String?     @db.Uuid

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @db.Uuid
  ipAddress       String
  userAgent       String
  status          String      // SUCCESS, FAILED
  failureReason   String?
  attemptedAt     DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model BlockedIp {
  id              String      @id @default(uuid()) @db.Uuid
  ipAddress       String      @unique
  reason          String
  blockedUntil    DateTime
  blockCount      Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid
}

model AdminAction {
  id              String      @id @default(uuid()) @db.Uuid
  adminId         String      @db.Uuid
  actionType      String
  description     String
  targetEntity    String
  targetId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid
}

model AuditLog {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @db.Uuid
  action          String
  entityName      String
  entityId        String?
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @db.Uuid
  type            LogType
  description     String
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ==========================================
// ADVANCED SECURITY & FRAUD
// ==========================================

model RiskProfile {
  id                   String     @id @default(uuid()) @db.Uuid
  userId               String     @unique @db.Uuid
  riskScore            Int        @default(0)
  status               RiskStatus @default(NORMAL)
  verificationAttempts Int        @default(0)
  flags                Json?
  reasons              String[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?
  createdBy            String?    @db.Uuid
  updatedBy            String?    @db.Uuid

  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FraudFlag {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  flagType        String
  description     String
  severity        SecuritySeverity
  status          FraudStatus      @default(ACTIVE)
  detectedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IpReputationLog {
  id             String    @id @default(uuid()) @db.Uuid
  ipAddress      String    @unique
  threatScore    Int
  isVpn          Boolean   @default(false)
  isProxy        Boolean   @default(false)
  countryCode    String?
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
}

model RevokedSession {
  id           String    @id @default(uuid()) @db.Uuid
  sessionToken String    @unique
  revokedAt    DateTime  @default(now())
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
}

model ImmutableAuditTrail {
  id            String    @id @default(uuid()) @db.Uuid
  auditLogId    String    @db.Uuid
  integrityHash String
  hashAlgorithm String    @default("SHA-256")
  verifiedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
}

// ==========================================
// AI MODULES
// ==========================================

model AiRecommendation {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  recommendedVehicleId String   @db.Uuid
  score               Decimal   @db.Decimal(3, 2)
  modelAlgorithm      String
  recommendedReason   String?
  viewed              Boolean   @default(false)
  clicked             Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  createdBy           String?   @db.Uuid
  updatedBy           String?   @db.Uuid

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle             Vehicle   @relation(fields: [recommendedVehicleId], references: [id], onDelete: Cascade)
}

model AiChatHistory {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @db.Uuid
  sessionToken   String
  messageText    String
  responseText   String
  sentimentScore Decimal?  @db.Decimal(3, 2)
  feedbackRating Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AiDamageDetectionResult {
  id                String    @id @default(uuid()) @db.Uuid
  damageReportId    String    @db.Uuid
  confidenceScore   Decimal   @db.Decimal(5, 2) // e.g. 0.9850 (98.50%)
  detectedDamageType String
  boundingBoxes     Json?
  annotatedImageUrl String?
  isConfirmedByAgent Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid

  damageReport      VehicleDamageReport @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
}

model AiPricingRecommendation {
  id                   String    @id @default(uuid()) @db.Uuid
  vehiclePricingId     String    @db.Uuid
  recommendedDailyRate Decimal   @db.Decimal(10, 2)
  recommendedReason    String?
  dynamicFactors       Json?
  applied              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid

  pricing              VehiclePricing @relation(fields: [vehiclePricingId], references: [id], onDelete: Cascade)
}

// ==========================================
// SYSTEM & COMMUNICATION MODULE
// ==========================================

model Notification {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  title           String
  message         String
  type            NotificationType
  status          NotificationStatus @default(UNREAD)
  readAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  createdBy       String?            @db.Uuid
  updatedBy       String?            @db.Uuid

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationTemplate {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @unique
  subject         String?
  body            String
  channels        NotificationType[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  createdBy       String?            @db.Uuid
  updatedBy       String?            @db.Uuid
}

model EmailSent {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String?     @db.Uuid
  recipientEmail    String
  subject           String
  body              String
  providerMessageId String?
  status            LogStatus
  errorReason       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  createdBy         String?     @db.Uuid
  updatedBy         String?     @db.Uuid

  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SmsLog {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String?        @db.Uuid
  recipientPhone    String
  message           String
  providerMessageId String?
  status            LogStatus
  errorReason       String?
  channelType       SmsChannelType
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  createdBy         String?        @db.Uuid
  updatedBy         String?        @db.Uuid

  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  keyHash         String      @unique
  description     String?
  userId          String      @db.Uuid
  scopes          String[]
  active          Boolean     @default(true)
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @unique
  description       String?
  active            Boolean     @default(false)
  percentageRollout Int         @default(100)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  createdBy         String?     @db.Uuid
  updatedBy       String?     @db.Uuid
}

model OtpCode {
  id              String      @id @default(uuid()) @db.Uuid
  identifier      String      // phone or email used for delivery
  codeHash        String      // hashed OTP
  type            OtpType
  expiresAt       DateTime
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3)
  verifiedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([identifier, type])
  @@index([createdAt])
}

model SystemSetting {
  id              String            @id @default(uuid()) @db.Uuid
  key             String            @unique
  value           String
  description     String?
  type            SystemSettingType @default(STRING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdBy       String?           @db.Uuid
  updatedBy       String?           @db.Uuid
}
