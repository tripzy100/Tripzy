generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS SECTION
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  PASSPORT
  AADHAR
  PAN
  NATIONAL_ID
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  BLOCKED
  INACTIVE
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
  TYRE
  WASH
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DamageSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DamageStatus {
  REPORTED
  UNDER_REVIEW
  REPAIRED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  REFUNDED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentGateway {
  CASHFREE
  RAZORPAY
}

enum TransactionType {
  CHARGE
  REFUND
  CAPTURE
  VOID
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SenderType {
  USER
  AGENT
}

enum LogType {
  LOGIN
  LOGOUT
  PAGE_VIEW
  KYC_SUBMIT
  BOOKING_CREATE
}

enum SystemSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum NotificationType {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  UNREAD
  READ
}

enum LogStatus {
  SENT
  FAILED
  DELIVERED
}

enum SmsChannelType {
  SMS
  WHATSAPP
}

enum OtpType {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Advanced Enums
enum TrackingSource {
  GPS
  MANUAL
  OBD
}

enum InspectionType {
  PRE_RENTAL
  POST_RENTAL
  ROUTINE
}

enum CleaningStatus {
  CLEAN
  DIRTY
  IN_PROGRESS
}

enum CleaningType {
  STANDARD
  DEEP
  SANITIZATION
}

enum ParkingStatus {
  PARKED
  DEPARTED
}

enum PromoCampaignType {
  COUPON
  MEMBERSHIP
  CASHBACK
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipTierCode {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ReferralStatus {
  INITIATED
  VERIFIED
  REWARDED
}

enum PointsTransactionType {
  EARNED
  REDEEMED
}

enum RiskStatus {
  NORMAL
  HIGH_RISK
  WATCHLIST
  BLOCKED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  ACTIVE
  INVESTIGATING
  RESOLVED
}

// ==========================================
// IDENTITY & PROFILE MODULE
// ==========================================

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  passwordHash    String
  phone           String?            @unique
  isKycVerified   Boolean            @default(false)
  phoneVerified   Boolean            @default(false)
  emailVerified   Boolean            @default(false)
  status          UserStatus         @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  createdBy       String?            @db.Uuid
  updatedBy       String?            @db.Uuid

  profile         Profile?
  drivingLicence  DrivingLicence?
  identities      IdentityDocument[]
  kycRequests     KycRequest[]
  emergencyContacts EmergencyContact[]
  wallet          Wallet?
  userRoles       UserRole[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  devices         Device[]
  trustedDevices  TrustedDevice[]
  loginHistories  LoginHistory[]
  auditLogs       AuditLog[]
  activityLogs    ActivityLog[]
  bookings        Booking[]
  reviews         Review[]
  supportTickets  SupportTicket[]
  apiKeys         ApiKey[]
  notifications   Notification[]
  emailsSent      EmailSent[]
  smsLogs         SmsLog[]
  couponUsages    CouponUsage[]

  // Advanced Relations
  userSubscriptions   UserSubscription[]
  savedPickupLocations SavedPickupLocation[]
  wishlists           Wishlist[]
  referralsSent       Referral[]             @relation("Referrer")
  referralsReceived   Referral[]             @relation("Referred")
  loyaltyPointLogs    LoyaltyPointLog[]
  driverScoreLogs     DriverScoreLog[]
  riskProfile         RiskProfile?
  fraudFlags          FraudFlag[]
  aiRecommendations   AiRecommendation[]
  aiChatHistories     AiChatHistory[]

  @@index([email])
  @@index([phone])
}

model Profile {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @unique @db.Uuid
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  avatarUrl       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses       Address[]
}

model Address {
  id              String      @id @default(uuid()) @db.Uuid
  profileId       String      @db.Uuid
  street          String
  cityId          String      @db.Uuid
  stateId         String      @db.Uuid
  countryId       String      @db.Uuid
  zipCode         String
  isDefault       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  profile         Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city            City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  state           State       @relation(fields: [stateId], references: [id], onDelete: Restrict)
  country         Country     @relation(fields: [countryId], references: [id], onDelete: Restrict)
}

model EmergencyContact {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  name            String
  relationship    String
  phone           String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DrivingLicence {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @db.Uuid
  licenceNumber   String         @unique
  issueCountry    String
  expiryDate      DateTime
  frontImageUrl   String
  backImageUrl    String
  status          DocumentStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityDocument {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  documentType    DocumentType
  documentNumber  String         @unique
  imageUrl        String
  status          DocumentStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycRequest {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  reviewerNotes   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            KycVerificationLog[]
}

model KycVerificationLog {
  id              String         @id @default(uuid()) @db.Uuid
  requestId       String         @db.Uuid
  reviewerId      String         @db.Uuid
  statusChangedTo DocumentStatus
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  request         KycRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ==========================================
// VEHICLE INFRASTRUCTURE MODULE
// ==========================================

model Vehicle {
  id              String           @id @default(uuid()) @db.Uuid
  plateNumber     String           @unique
  vin             String           @unique
  brandId         String           @db.Uuid
  modelId         String           @db.Uuid
  variantId       String           @db.Uuid
  categoryId      String           @db.Uuid
  color           String
  transmission    TransmissionType
  fuelType        FuelType
  status          VehicleStatus    @default(AVAILABLE)
  locationId      String           @db.Uuid
  mileage         Int
  statusReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid

  brand           VehicleBrand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model           VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  variant         VehicleVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  category        VehicleCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city            City             @relation(fields: [locationId], references: [id], onDelete: Restrict)

  images          VehicleImage[]
  features        VehicleFeaturesOnVehicles[]
  pricings        VehiclePricing[]
  calendar        VehicleAvailabilityCalendar[]
  maintenances    VehicleMaintenance[]
  damages         VehicleDamageReport[]
  insurances      VehicleInsurance[]
  bookings        Booking[]
  reviews         Review[]

  // Advanced IoT and Ops Relations
  gpsRecords            GpsTrackerRecord[]
  telematics            VehicleTelematics[]
  odometerHistory       OdometerHistory[]
  fuelLevelHistory      FuelLevelHistory[]
  inspections           VehicleInspectionChecklist[]
  cleaningLogs          CleaningLog[]
  parkingLocationHistory ParkingLocationHistory[]
  wishlists             Wishlist[]
  aiRecommendations     AiRecommendation[]

  @@index([status])
  @@index([locationId])
  @@index([brandId])
  @@index([categoryId])
}

model VehicleImage {
  id              String      @id @default(uuid()) @db.Uuid
  vehicleId       String      @db.Uuid
  imageUrl        String
  isPrimary       Boolean     @default(false)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleFeature {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @unique
  description     String?
  icon            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicles        VehicleFeaturesOnVehicles[]
}

model VehicleFeaturesOnVehicles {
  vehicleId       String      @db.Uuid
  featureId       String      @db.Uuid

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  feature         VehicleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([vehicleId, featureId])
}

model VehicleCategory {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  slug            String      @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicles        Vehicle[]
}

model VehicleBrand {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  logoUrl         String?
  slug            String      @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicles        Vehicle[]
  models          VehicleModel[]
}

model VehicleModel {
  id              String      @id @default(uuid()) @db.Uuid
  brandId         String      @db.Uuid
  name            String
  year            Int
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  brand           VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants        VehicleVariant[]
  vehicles        Vehicle[]
  wishlists       Wishlist[]
}

model VehicleVariant {
  id              String      @id @default(uuid()) @db.Uuid
  modelId         String      @db.Uuid
  name            String
  engineCapacity  Int?
  transmission    TransmissionType
  fuelType        FuelType
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  model           VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]
}

model VehiclePricing {
  id                String      @id @default(uuid()) @db.Uuid
  vehicleId         String      @db.Uuid
  hourlyRate        Decimal     @db.Decimal(10, 2)
  dailyRate         Decimal     @db.Decimal(10, 2)
  weeklyRate        Decimal     @db.Decimal(10, 2)
  monthlyRate       Decimal     @db.Decimal(10, 2)
  basePrice         Decimal     @db.Decimal(10, 2)
  dynamicMultiplier Decimal     @default(1.0) @db.Decimal(3, 2)
  peakMultiplier    Decimal     @default(1.0) @db.Decimal(3, 2)
  weekendMultiplier Decimal     @default(1.0) @db.Decimal(3, 2)
  holidayMultiplier Decimal     @default(1.0) @db.Decimal(3, 2)
  securityDeposit   Decimal     @db.Decimal(10, 2)
  taxRate           Decimal     @default(18.0) @db.Decimal(5, 2)
  extraKmCharge     Decimal?    @default(15.0) @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  createdBy         String?     @db.Uuid
  updatedBy         String?     @db.Uuid

  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  aiPricingRecommendations AiPricingRecommendation[]
}

model VehicleAvailabilityCalendar {
  id              String      @id @default(uuid()) @db.Uuid
  vehicleId       String      @db.Uuid
  date            DateTime
  isAvailable     Boolean     @default(true)
  blockReason     String?
  bookingId       String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking         Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([vehicleId, date])
  @@index([date])
}

model VehicleMaintenance {
  id              String            @id @default(uuid()) @db.Uuid
  vehicleId       String            @db.Uuid
  type            MaintenanceType
  description     String
  cost            Decimal           @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime?
  status          MaintenanceStatus @default(SCHEDULED)
  providerName    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdBy       String?           @db.Uuid
  updatedBy       String?           @db.Uuid

  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleDamageReport {
  id                 String         @id @default(uuid()) @db.Uuid
  vehicleId          String         @db.Uuid
  bookingId          String?        @db.Uuid
  reporterId         String         @db.Uuid
  description        String
  severity           DamageSeverity
  reportedAt         DateTime       @default(now())
  isInsuranceClaimed Boolean        @default(false)
  status             DamageStatus   @default(REPORTED)
  images             Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  createdBy          String?        @db.Uuid
  updatedBy          String?        @db.Uuid

  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking            Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  aiDamageDetectionResults AiDamageDetectionResult[]
}

model VehicleInsurance {
  id              String       @id @default(uuid()) @db.Uuid
  vehicleId       String       @db.Uuid
  policyNumber    String       @unique
  providerName    String
  startDate       DateTime
  endDate         DateTime
  coverageAmount  Decimal      @db.Decimal(12, 2)
  premiumAmount   Decimal      @db.Decimal(10, 2)
  policyDocumentUrl String?
  status          PolicyStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdBy       String?      @db.Uuid
  updatedBy       String?      @db.Uuid

  vehicle         Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model FuelPolicy {
  id                     String      @id @default(uuid()) @db.Uuid
  name                   String
  description            String
  chargePerLiterShortage Decimal     @db.Decimal(10, 2)
  refundPerLiterExcess   Decimal     @db.Decimal(10, 2)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?
  createdBy              String?     @db.Uuid
  updatedBy              String?     @db.Uuid

  bookings               Booking[]
}

// ==========================================
// ADVANCED FLEET OPERATIONS & IOT
// ==========================================

model GpsTrackerRecord {
  id              String      @id @default(uuid()) @db.Uuid
  vehicleId       String      @db.Uuid
  latitude        Float
  longitude       Float
  speed           Float
  heading         Float
  capturedAt      DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, capturedAt])
}

model VehicleTelematics {
  id              String      @id @default(uuid()) @db.Uuid
  vehicleId       String      @db.Uuid
  batteryVoltage  Float?
  tirePressure    Json?
  engineOilStatus String?
  odometer        Int?
  fuelLevel       Float?
  diagnosticCodes Json?
  capturedAt      DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, capturedAt])
}

model OdometerHistory {
  id              String         @id @default(uuid()) @db.Uuid
  vehicleId       String         @db.Uuid
  bookingId       String?        @db.Uuid
  reading         Int
  capturedAt      DateTime       @default(now())
  source          TrackingSource @default(GPS)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model FuelLevelHistory {
  id              String         @id @default(uuid()) @db.Uuid
  vehicleId       String         @db.Uuid
  bookingId       String?        @db.Uuid
  percentage      Float
  liters          Float?
  capturedAt      DateTime       @default(now())
  source          TrackingSource @default(GPS)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model VehicleInspectionChecklist {
  id                 String         @id @default(uuid()) @db.Uuid
  vehicleId          String         @db.Uuid
  bookingId          String?        @db.Uuid
  inspectorId        String         @db.Uuid
  inspectionType     InspectionType
  exteriorStatus     String
  interiorStatus     String
  mechanicalStatus   String
  cleanlinessRating  Int
  notes              String?
  photos             Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  createdBy          String?        @db.Uuid
  updatedBy          String?        @db.Uuid

  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking            Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model CleaningLog {
  id              String         @id @default(uuid()) @db.Uuid
  vehicleId       String         @db.Uuid
  cleanerId       String         @db.Uuid
  cleaningStatus  CleaningStatus @default(CLEAN)
  cleaningType    CleaningType   @default(STANDARD)
  cost            Decimal?       @db.Decimal(10, 2)
  checklistUrl    String?
  photos          Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model ParkingLocationHistory {
  id              String        @id @default(uuid()) @db.Uuid
  vehicleId       String        @db.Uuid
  parkingLotName  String
  bayNumber       String?
  enteredAt       DateTime      @default(now())
  leftAt          DateTime?
  latitude        Float?
  longitude       Float?
  status          ParkingStatus @default(PARKED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid

  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ==========================================
// GEOGRAPHY & LOCATIONS
// ==========================================

model Country {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  code            String      @unique
  phoneCode       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  createdBy       String?     @db.Uuid
  updatedBy       String?     @db.Uuid

  states          State[]
  addresses       Address[]
}

model State {
