generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  passwordHash         String
  phone                String?               @unique
  isKycVerified        Boolean               @default(false)
  phoneVerified        Boolean               @default(false)
  emailVerified        Boolean               @default(false)
  status               UserStatus            @default(PENDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  createdBy            String?               @db.Uuid
  updatedBy            String?               @db.Uuid
  activityLogs         ActivityLog[]
  aiChatHistories      AiChatHistory[]
  aiRecommendations    AiRecommendation[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  bookings             Booking[]
  couponUsages         CouponUsage[]
  devices              Device[]
  driverScoreLogs      DriverScoreLog[]
  drivingLicence       DrivingLicence?
  emailsSent           EmailSent[]
  emergencyContacts    EmergencyContact[]
  fraudFlags           FraudFlag[]
  identities           IdentityDocument[]
  kycRequests          KycRequest[]
  loginHistories       LoginHistory[]
  loyaltyPointLogs     LoyaltyPointLog[]
  notifications        Notification[]
  profile              Profile?
  referralsReceived    Referral[]            @relation("Referred")
  referralsSent        Referral[]            @relation("Referrer")
  refreshTokens        RefreshToken[]
  reviews              Review[]
  riskProfile          RiskProfile?
  savedPickupLocations SavedPickupLocation[]
  sessions             Session[]
  smsLogs              SmsLog[]
  supportTickets       SupportTicket[]
  trustedDevices       TrustedDevice[]
  userRoles            UserRole[]
  userSubscriptions    UserSubscription[]
  wallet               Wallet?
  wishlists            Wishlist[]

  @@index([email])
  @@index([phone])
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  addresses   Address[]
  user        User      @relation(fields: [userId], references: [id])
}

model Address {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @db.Uuid
  street    String
  cityId    String    @db.Uuid
  stateId   String    @db.Uuid
  countryId String    @db.Uuid
  zipCode   String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  city      City      @relation(fields: [cityId], references: [id])
  country   Country   @relation(fields: [countryId], references: [id])
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  state     State     @relation(fields: [stateId], references: [id])
}

model EmergencyContact {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  name         String
  relationship String
  phone        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DrivingLicence {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @db.Uuid
  licenceNumber String         @unique
  issueCountry  String
  expiryDate    DateTime
  frontImageUrl String
  backImageUrl  String
  status        DocumentStatus @default(PENDING)
  verifiedAt    DateTime?
  verifiedBy    String?        @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  createdBy     String?        @db.Uuid
  updatedBy     String?        @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityDocument {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  documentType   DocumentType
  documentNumber String         @unique
  imageUrl       String
  status         DocumentStatus @default(PENDING)
  verifiedAt     DateTime?
  verifiedBy     String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  createdBy      String?        @db.Uuid
  updatedBy      String?        @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycRequest {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  status          DocumentStatus       @default(PENDING)
  rejectionReason String?
  reviewerNotes   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  createdBy       String?              @db.Uuid
  updatedBy       String?              @db.Uuid
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            KycVerificationLog[]
}

model KycVerificationLog {
  id              String         @id @default(uuid()) @db.Uuid
  requestId       String         @db.Uuid
  reviewerId      String         @db.Uuid
  statusChangedTo DocumentStatus
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid
  request         KycRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                     String                        @id @default(uuid()) @db.Uuid
  plateNumber            String                        @unique
  vin                    String                        @unique
  brandId                String                        @db.Uuid
  modelId                String                        @db.Uuid
  variantId              String                        @db.Uuid
  categoryId             String                        @db.Uuid
  color                  String
  transmission           TransmissionType
  fuelType               FuelType
  status                 VehicleStatus                 @default(AVAILABLE)
  locationId             String                        @db.Uuid
  mileage                Int
  statusReason           String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  deletedAt              DateTime?
  createdBy              String?                       @db.Uuid
  updatedBy              String?                       @db.Uuid
  aiRecommendations      AiRecommendation[]
  bookings               Booking[]
  cleaningLogs           CleaningLog[]
  fuelLevelHistory       FuelLevelHistory[]
  gpsRecords             GpsTrackerRecord[]
  odometerHistory        OdometerHistory[]
  parkingLocationHistory ParkingLocationHistory[]
  reviews                Review[]
  brand                  VehicleBrand                  @relation(fields: [brandId], references: [id])
  category               VehicleCategory               @relation(fields: [categoryId], references: [id])
  city                   City                          @relation(fields: [locationId], references: [id])
  model                  VehicleModel                  @relation(fields: [modelId], references: [id])
  variant                VehicleVariant                @relation(fields: [variantId], references: [id])
  calendar               VehicleAvailabilityCalendar[]
  damages                VehicleDamageReport[]
  features               VehicleFeaturesOnVehicles[]
  images                 VehicleImage[]
  inspections            VehicleInspectionChecklist[]
  insurances             VehicleInsurance[]
  maintenances           VehicleMaintenance[]
  pricings               VehiclePricing[]
  telematics             VehicleTelematics[]
  wishlists              Wishlist[]

  @@index([status])
  @@index([locationId])
  @@index([brandId])
  @@index([categoryId])
}

model VehicleImage {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String    @db.Uuid
  imageUrl  String
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleFeature {
  id          String                      @id @default(uuid()) @db.Uuid
  name        String                      @unique
  description String?
  icon        String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  deletedAt   DateTime?
  createdBy   String?                     @db.Uuid
  updatedBy   String?                     @db.Uuid
  vehicles    VehicleFeaturesOnVehicles[]
}

model VehicleFeaturesOnVehicles {
  vehicleId String         @db.Uuid
  featureId String         @db.Uuid
  feature   VehicleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([vehicleId, featureId])
}

model VehicleCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  vehicles    Vehicle[]
}

model VehicleBrand {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  logoUrl     String?
  slug        String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  createdBy   String?        @db.Uuid
  updatedBy   String?        @db.Uuid
  vehicles    Vehicle[]
  models      VehicleModel[]
}

model VehicleModel {
  id          String           @id @default(uuid()) @db.Uuid
  brandId     String           @db.Uuid
  name        String
  year        Int
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  vehicles    Vehicle[]
  brand       VehicleBrand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants    VehicleVariant[]
  wishlists   Wishlist[]
}

model VehicleVariant {
  id             String           @id @default(uuid()) @db.Uuid
  modelId        String           @db.Uuid
  name           String
  engineCapacity Int?
  transmission   TransmissionType
  fuelType       FuelType
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  createdBy      String?          @db.Uuid
  updatedBy      String?          @db.Uuid
  vehicles       Vehicle[]
  model          VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model VehiclePricing {
  id                       String                    @id @default(uuid()) @db.Uuid
  vehicleId                String                    @db.Uuid
  hourlyRate               Decimal                   @db.Decimal(10, 2)
  dailyRate                Decimal                   @db.Decimal(10, 2)
  weeklyRate               Decimal                   @db.Decimal(10, 2)
  monthlyRate              Decimal                   @db.Decimal(10, 2)
  basePrice                Decimal                   @db.Decimal(10, 2)
  dynamicMultiplier        Decimal                   @default(1.0) @db.Decimal(3, 2)
  peakMultiplier           Decimal                   @default(1.0) @db.Decimal(3, 2)
  weekendMultiplier        Decimal                   @default(1.0) @db.Decimal(3, 2)
  holidayMultiplier        Decimal                   @default(1.0) @db.Decimal(3, 2)
  securityDeposit          Decimal                   @db.Decimal(10, 2)
  taxRate                  Decimal                   @default(18.0) @db.Decimal(5, 2)
  extraKmCharge            Decimal?                  @default(15.0) @db.Decimal(10, 2)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  createdBy                String?                   @db.Uuid
  updatedBy                String?                   @db.Uuid
  aiPricingRecommendations AiPricingRecommendation[]
  vehicle                  Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleAvailabilityCalendar {
  id          String    @id @default(uuid()) @db.Uuid
  vehicleId   String    @db.Uuid
  date        DateTime
  isAvailable Boolean   @default(true)
  blockReason String?
  bookingId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, date])
  @@index([date])
}

model VehicleMaintenance {
  id           String            @id @default(uuid()) @db.Uuid
  vehicleId    String            @db.Uuid
  type         MaintenanceType
  description  String
  cost         Decimal           @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime?
  status       MaintenanceStatus @default(SCHEDULED)
  providerName String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  createdBy    String?           @db.Uuid
  updatedBy    String?           @db.Uuid
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleDamageReport {
  id                       String                    @id @default(uuid()) @db.Uuid
  vehicleId                String                    @db.Uuid
  bookingId                String?                   @db.Uuid
  reporterId               String                    @db.Uuid
  description              String
  severity                 DamageSeverity
  reportedAt               DateTime                  @default(now())
  isInsuranceClaimed       Boolean                   @default(false)
  status                   DamageStatus              @default(REPORTED)
  images                   Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  createdBy                String?                   @db.Uuid
  updatedBy                String?                   @db.Uuid
  aiDamageDetectionResults AiDamageDetectionResult[]
  booking                  Booking?                  @relation(fields: [bookingId], references: [id])
  vehicle                  Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleInsurance {
  id                String       @id @default(uuid()) @db.Uuid
  vehicleId         String       @db.Uuid
  policyNumber      String       @unique
  providerName      String
  startDate         DateTime
  endDate           DateTime
  coverageAmount    Decimal      @db.Decimal(12, 2)
  premiumAmount     Decimal      @db.Decimal(10, 2)
  policyDocumentUrl String?
  status            PolicyStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  createdBy         String?      @db.Uuid
  updatedBy         String?      @db.Uuid
  vehicle           Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model FuelPolicy {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String
  description            String
  chargePerLiterShortage Decimal   @db.Decimal(10, 2)
  refundPerLiterExcess   Decimal   @db.Decimal(10, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  createdBy              String?   @db.Uuid
  updatedBy              String?   @db.Uuid
  bookings               Booking[]
}

model GpsTrackerRecord {
  id         String    @id @default(uuid()) @db.Uuid
  vehicleId  String    @db.Uuid
  latitude   Float
  longitude  Float
  speed      Float
  heading    Float
  capturedAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, capturedAt])
}

model VehicleTelematics {
  id              String    @id @default(uuid()) @db.Uuid
  vehicleId       String    @db.Uuid
  batteryVoltage  Float?
  tirePressure    Json?
  engineOilStatus String?
  odometer        Int?
  fuelLevel       Float?
  diagnosticCodes Json?
  capturedAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?   @db.Uuid
  updatedBy       String?   @db.Uuid
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, capturedAt])
}

model OdometerHistory {
  id         String         @id @default(uuid()) @db.Uuid
  vehicleId  String         @db.Uuid
  bookingId  String?        @db.Uuid
  reading    Int
  capturedAt DateTime       @default(now())
  source     TrackingSource @default(GPS)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  createdBy  String?        @db.Uuid
  updatedBy  String?        @db.Uuid
  booking    Booking?       @relation(fields: [bookingId], references: [id])
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model FuelLevelHistory {
  id         String         @id @default(uuid()) @db.Uuid
  vehicleId  String         @db.Uuid
  bookingId  String?        @db.Uuid
  percentage Float
  liters     Float?
  capturedAt DateTime       @default(now())
  source     TrackingSource @default(GPS)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  createdBy  String?        @db.Uuid
  updatedBy  String?        @db.Uuid
  booking    Booking?       @relation(fields: [bookingId], references: [id])
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleInspectionChecklist {
  id                String         @id @default(uuid()) @db.Uuid
  vehicleId         String         @db.Uuid
  bookingId         String?        @db.Uuid
  inspectorId       String         @db.Uuid
  inspectionType    InspectionType
  exteriorStatus    String
  interiorStatus    String
  mechanicalStatus  String
  cleanlinessRating Int
  notes             String?
  photos            Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  createdBy         String?        @db.Uuid
  updatedBy         String?        @db.Uuid
  booking           Booking?       @relation(fields: [bookingId], references: [id])
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model CleaningLog {
  id             String         @id @default(uuid()) @db.Uuid
  vehicleId      String         @db.Uuid
  cleanerId      String         @db.Uuid
  cleaningStatus CleaningStatus @default(CLEAN)
  cleaningType   CleaningType   @default(STANDARD)
  cost           Decimal?       @db.Decimal(10, 2)
  checklistUrl   String?
  photos         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  createdBy      String?        @db.Uuid
  updatedBy      String?        @db.Uuid
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model ParkingLocationHistory {
  id             String        @id @default(uuid()) @db.Uuid
  vehicleId      String        @db.Uuid
  parkingLotName String
  bayNumber      String?
  enteredAt      DateTime      @default(now())
  leftAt         DateTime?
  latitude       Float?
  longitude      Float?
  status         ParkingStatus @default(PARKED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  createdBy      String?       @db.Uuid
  updatedBy      String?       @db.Uuid
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Country {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  code      String    @unique
  phoneCode String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  addresses Address[]
  states    State[]
}

model State {
  id        String    @id @default(uuid()) @db.Uuid
  countryId String    @db.Uuid
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  addresses Address[]
  cities    City[]
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
}

model City {
  id               String            @id @default(uuid()) @db.Uuid
  stateId          String            @db.Uuid
  name             String
  code             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  createdBy        String?           @db.Uuid
  updatedBy        String?           @db.Uuid
  addresses        Address[]
  state            State             @relation(fields: [stateId], references: [id], onDelete: Cascade)
  dropLocations    DropLocation[]
  pickupLocations  PickupLocation[]
  surgePricingLogs SurgePricingLog[]
  vehicles         Vehicle[]

  @@index([stateId])
}

model PickupLocation {
  id               String    @id @default(uuid()) @db.Uuid
  cityId           String    @db.Uuid
  name             String
  address          String
  latitude         Float
  longitude        Float
  isAirport        Boolean   @default(false)
  isRailwayStation Boolean   @default(false)
  deliveryCharge   Decimal   @default(0.0) @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  bookings         Booking[]
  city             City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model DropLocation {
  id               String    @id @default(uuid()) @db.Uuid
  cityId           String    @db.Uuid
  name             String
  address          String
  latitude         Float
  longitude        Float
  isAirport        Boolean   @default(false)
  isRailwayStation Boolean   @default(false)
  deliveryCharge   Decimal   @default(0.0) @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  bookings         Booking[]
  city             City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String                        @id @default(uuid()) @db.Uuid
  bookingNumber      String                        @unique
  userId             String                        @db.Uuid
  vehicleId          String                        @db.Uuid
  pickupLocationId   String                        @db.Uuid
  dropLocationId     String                        @db.Uuid
  fuelPolicyId       String?                       @db.Uuid
  pickupDate         DateTime
  returnDate         DateTime
  status             BookingStatus                 @default(PENDING)
  totalAmount        Decimal                       @db.Decimal(10, 2)
  securityDeposit    Decimal                       @db.Decimal(10, 2)
  couponId           String?                       @db.Uuid
  discountAmount     Decimal                       @default(0.0) @db.Decimal(10, 2)
  taxAmount          Decimal                       @db.Decimal(10, 2)
  finalAmount        Decimal                       @db.Decimal(10, 2)
  actualReturnDate   DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  deletedAt          DateTime?
  createdBy          String?                       @db.Uuid
  updatedBy          String?                       @db.Uuid
  coupon             Coupon?                       @relation(fields: [couponId], references: [id])
  dropLocation       DropLocation                  @relation(fields: [dropLocationId], references: [id])
  fuelPolicy         FuelPolicy?                   @relation(fields: [fuelPolicyId], references: [id])
  pickupLocation     PickupLocation                @relation(fields: [pickupLocationId], references: [id])
  user               User                          @relation(fields: [userId], references: [id])
  vehicle            Vehicle                       @relation(fields: [vehicleId], references: [id])
  cancellations      BookingCancellation[]
  extensions         BookingExtension[]
  timelines          BookingTimeline[]
  couponUsages       CouponUsage[]
  driverScoreLogs    DriverScoreLog[]
  fuelLevelHistory   FuelLevelHistory[]
  invoices           Invoice[]
  loyaltyPointLogs   LoyaltyPointLog[]
  odometerHistory    OdometerHistory[]
  payments           Payment[]
  reviews            Review[]
  calendarBlocks     VehicleAvailabilityCalendar[]
  damageReports      VehicleDamageReport[]
  inspections        VehicleInspectionChecklist[]
  walletTransactions WalletTransaction[]

  @@index([status])
  @@index([pickupDate])
  @@index([returnDate])
  @@index([userId])
}

model BookingTimeline {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  statusChangedTo BookingStatus
  remarks         String?
  actionBy        String        @db.Uuid
  timestamp       DateTime      @default(now())
