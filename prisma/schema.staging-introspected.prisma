  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
}

model AiRecommendation {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  recommendedVehicleId String    @db.Uuid
  score                Decimal   @db.Decimal(3, 2)
  modelAlgorithm       String
  recommendedReason    String?
  viewed               Boolean   @default(false)
  clicked              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid
  vehicle              Vehicle   @relation(fields: [recommendedVehicleId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiChatHistory {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @db.Uuid
  sessionToken   String
  messageText    String
  responseText   String
  sentimentScore Decimal?  @db.Decimal(3, 2)
  feedbackRating Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  user           User?     @relation(fields: [userId], references: [id])
}

model AiDamageDetectionResult {
  id                 String              @id @default(uuid()) @db.Uuid
  damageReportId     String              @db.Uuid
  confidenceScore    Decimal             @db.Decimal(5, 2)
  detectedDamageType String
  boundingBoxes      Json?
  annotatedImageUrl  String?
  isConfirmedByAgent Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdBy          String?             @db.Uuid
  updatedBy          String?             @db.Uuid
  damageReport       VehicleDamageReport @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
}

model AiPricingRecommendation {
  id                   String         @id @default(uuid()) @db.Uuid
  vehiclePricingId     String         @db.Uuid
  recommendedDailyRate Decimal        @db.Decimal(10, 2)
  recommendedReason    String?
  dynamicFactors       Json?
  applied              Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?
  createdBy            String?        @db.Uuid
  updatedBy            String?        @db.Uuid
  pricing              VehiclePricing @relation(fields: [vehiclePricingId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  title     String
  message   String
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  createdBy String?            @db.Uuid
  updatedBy String?            @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationTemplate {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  subject   String?
  body      String
  channels  NotificationType[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  createdBy String?            @db.Uuid
  updatedBy String?            @db.Uuid
}

model EmailSent {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?   @db.Uuid
  recipientEmail    String
  subject           String
  body              String
  providerMessageId String?
  status            LogStatus
  errorReason       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid
  user              User?     @relation(fields: [userId], references: [id])
}

model SmsLog {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String?        @db.Uuid
  recipientPhone    String
  message           String
  providerMessageId String?
  status            LogStatus
  errorReason       String?
  channelType       SmsChannelType
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  createdBy         String?        @db.Uuid
  updatedBy         String?        @db.Uuid
  user              User?          @relation(fields: [userId], references: [id])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  keyHash     String    @unique
  description String?
  userId      String    @db.Uuid
  scopes      String[]
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @unique
  description       String?
  active            Boolean   @default(false)
  percentageRollout Int       @default(100)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid
}

model OtpCode {
  id          String    @id @default(uuid()) @db.Uuid
  identifier  String
  codeHash    String
  type        OtpType
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([identifier, type])
  @@index([createdAt])
}

model SystemSetting {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique
  value       String
  description String?
  type        SystemSettingType @default(STRING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  createdBy   String?           @db.Uuid
  updatedBy   String?           @db.Uuid
}

